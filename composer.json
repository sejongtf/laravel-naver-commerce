{
    "name": "sejongtf/laravel-naver-commerce",
    "description": "Laravel client for the Naver Commerce API (스마트스토어 커머스API)",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "naver", "commerce", "smartstore", "api"],
    "authors": [
        {
            "name": "Minhyung Park",
            "email": "minhyung.park@sejongtf.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.11",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sejongtf\\LaravelNaverCommerce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sejongtf\\LaravelNaverCommerce\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sejongtf\\LaravelNaverCommerce\\NaverCommerceServiceProvider"
            ],
            "aliases": {
                "NaverCommerce": "Sejongtf\\LaravelNaverCommerce\\Facades\\NaverCommerce"
            }
        }
    }
}
